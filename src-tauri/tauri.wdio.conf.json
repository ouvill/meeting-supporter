{
  "identifier": "net.ouvill.meeting-supporter.wdio",
  "build": {
    "beforeBuildCommand": "npm run prepare:python-resource && npm run build:wdio",
    "features": []
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "WebDriver permissions used only by desktop smoke tests",
          "windows": ["main", "assistant"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../generated/rust-resources/native": null,
      "../generated/python-worker/dist/meeting-python-worker": null,
      "../generated/tauri/python": "python"
    }
  }
}
