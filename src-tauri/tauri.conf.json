{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Supporter",
  "version": "0.1.0",
  "identifier": "net.ouvill.meeting-supporter",
  "build": {
    "beforeDevCommand": "node scripts/prepare-rust-resources.mjs --dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:rust-resources && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "会議支援AI",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "shadow": true
      },
      {
        "label": "assistant",
        "title": "ライブ返答支援",
        "width": 390,
        "height": 700,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' blob:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "会議中に次の一言を提案するデスクトップ支援アプリ",
    "longDescription": "会議中の会話を聞き取り、利用者が必要なときに短い「次の一言」を提案します。",
    "copyright": "Copyright © 2026 Meeting Supporter contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../generated/rust-resources/native": "native",
      "../generated/python-worker/dist/meeting-python-worker": "python-worker"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "meeting-supporter"
        ]
      }
    }
  }
}
