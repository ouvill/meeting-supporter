{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 5am on monday"
  ],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group Tauri npm packages",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@tauri-apps\\//"
      ],
      "groupName": "tauri-npm"
    },
    {
      "description": "Group npm frontend minor/patch updates (non-Tauri)",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/^@tauri-apps\\//"
      ],
      "groupName": "npm-non-tauri"
    },
    {
      "description": "Group Cargo/Tauri dependency updates",
      "matchManagers": [
        "cargo"
      ],
      "groupName": "cargo-tauri"
    }
  ]
}
