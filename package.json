{
  "name": "meeting-supporter",
  "private": true,
  "version": "0.1.0",
  "description": "会議中の会話を聞き取り、返答案を示すデスクトップ支援アプリ",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ouvill/meeting-supporter.git"
  },
  "bugs": {
    "url": "https://github.com/ouvill/meeting-supporter/issues"
  },
  "homepage": "https://github.com/ouvill/meeting-supporter#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:python": "node scripts/run-python-dev.mjs",
    "build": "tsc && vite build",
    "check:cla": "node scripts/check-cla.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:public": "node scripts/check-public-boundary.mjs && node scripts/check-docs.mjs && node scripts/check-cla.mjs",
    "check:release": "npm run check:cla && node scripts/check-release.mjs",
    "prepare:python-resource": "node scripts/prepare-python-resource.mjs",
    "preview": "vite preview",
    "site:dev": "vite website",
    "site:build": "vite build website --base ./ --outDir ../dist-website --emptyOutDir",
    "tauri": "tauri",
    "licenses:generate": "uv run --project python python scripts/third-party-licenses.py",
    "licenses:check": "uv run --project python python scripts/third-party-licenses.py --check",
    "generate:openapi": "cd python && uv run poe generate-openapi",
    "generate:api": "npm run generate:openapi && openapi-ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wdio": "tsc && vite build --mode wdio",
    "test:tauri:build": "tauri build --ci --debug --no-bundle --features webdriver --config src-tauri/tauri.wdio.conf.json",
    "test:tauri:wdio": "node scripts/run-tauri-wdio.mjs wdio.tauri.conf.ts",
    "test:tauri": "npm run test:tauri:build && npm run test:tauri:wdio",
    "test:tauri:linux": "node scripts/run-linux-tauri-e2e.mjs",
    "test:tauri:live-codex": "npm run test:tauri:build && node scripts/run-tauri-wdio.mjs wdio.live-codex.conf.ts"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toggle-group": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.12.1",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "typescript-language-server": "^6.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "webdriverio": "^9.29.1"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0",
    "@puppeteer/browsers": "3.2.1",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "nanoid": "3.3.18",
    "serialize-javascript": "7.0.5"
  }
}
